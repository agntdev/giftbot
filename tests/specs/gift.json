[
  {
    "name": "ordinary activity is recorded without a chat reply",
    "strict": true,
    "steps": [
      {
        "send": { "text": "Я здесь!", "chatId": -100, "userId": 7 },
        "expect": []
      }
    ]
  },
  {
    "name": "/gift",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage"
          }
        ],
        "send": {
          "text": "/gift"
        }
      }
    ]
  },
  {
    "name": "active chatter can receive a button giveaway",
    "steps": [
      { "send": { "text": "I am here!" }, "expect": [] },
      { "send": { "callback": "gift:run" }, "expect": [
        { "method": "answerCallbackQuery" },
        { "method": "editMessageText" }
      ] }
    ]
  },
  {
    "name": "settings are protected outside a group",
    "steps": [
      { "send": { "callback": "gift:auto" }, "expect": [{ "method": "answerCallbackQuery" }] }
    ]
  }
]
